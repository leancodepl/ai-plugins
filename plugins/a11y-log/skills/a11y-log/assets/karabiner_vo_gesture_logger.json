{
  "title": "VoiceOver gesture logger (for vo_log.sh)",
  "rules": [
    {
      "description": "VO+Shift+Down → log vo-interact (passthrough)",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "down_arrow",
            "modifiers": { "mandatory": ["control", "option", "shift"], "optional": ["caps_lock"] }
          },
          "to": [
            { "shell_command": "__VO_GESTURE_SH__ vo-interact" },
            { "key_code": "down_arrow", "modifiers": ["left_control", "left_option", "left_shift"] }
          ]
        }
      ]
    },
    {
      "description": "VO+Shift+Up → log vo-stop-interact (passthrough)",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "up_arrow",
            "modifiers": { "mandatory": ["control", "option", "shift"], "optional": ["caps_lock"] }
          },
          "to": [
            { "shell_command": "__VO_GESTURE_SH__ vo-stop-interact" },
            { "key_code": "up_arrow", "modifiers": ["left_control", "left_option", "left_shift"] }
          ]
        }
      ]
    },
    {
      "description": "VO+Right → log vo-right (passthrough)",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "right_arrow",
            "modifiers": { "mandatory": ["control", "option"], "optional": ["caps_lock"] }
          },
          "to": [
            { "shell_command": "__VO_GESTURE_SH__ vo-right" },
            { "key_code": "right_arrow", "modifiers": ["left_control", "left_option"] }
          ]
        }
      ]
    },
    {
      "description": "VO+Left → log vo-left (passthrough)",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "left_arrow",
            "modifiers": { "mandatory": ["control", "option"], "optional": ["caps_lock"] }
          },
          "to": [
            { "shell_command": "__VO_GESTURE_SH__ vo-left" },
            { "key_code": "left_arrow", "modifiers": ["left_control", "left_option"] }
          ]
        }
      ]
    },
    {
      "description": "VO+Down → log vo-down (passthrough)",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "down_arrow",
            "modifiers": { "mandatory": ["control", "option"], "optional": ["caps_lock"] }
          },
          "to": [
            { "shell_command": "__VO_GESTURE_SH__ vo-down" },
            { "key_code": "down_arrow", "modifiers": ["left_control", "left_option"] }
          ]
        }
      ]
    },
    {
      "description": "VO+Up → log vo-up (passthrough)",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "up_arrow",
            "modifiers": { "mandatory": ["control", "option"], "optional": ["caps_lock"] }
          },
          "to": [
            { "shell_command": "__VO_GESTURE_SH__ vo-up" },
            { "key_code": "up_arrow", "modifiers": ["left_control", "left_option"] }
          ]
        }
      ]
    },
    {
      "description": "VO+Space → log vo-space/activate (passthrough)",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "spacebar",
            "modifiers": { "mandatory": ["control", "option"], "optional": ["caps_lock"] }
          },
          "to": [
            { "shell_command": "__VO_GESTURE_SH__ vo-space" },
            { "key_code": "spacebar", "modifiers": ["left_control", "left_option"] }
          ]
        }
      ]
    },
    {
      "description": "VO+Cmd+H → log vo-next-heading (passthrough)",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "h",
            "modifiers": { "mandatory": ["control", "option", "command"], "optional": ["caps_lock"] }
          },
          "to": [
            { "shell_command": "__VO_GESTURE_SH__ vo-next-heading" },
            { "key_code": "h", "modifiers": ["left_control", "left_option", "left_command"] }
          ]
        }
      ]
    }
  ]
}
